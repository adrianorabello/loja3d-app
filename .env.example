# Deployment variables (Vercel Project Settings > Environment Variables). Placeholders only.
# Used by scripts/set-env.js during `npm run build:vercel`.

# local | dev | prod. Optional on Vercel: derived from VERCEL_ENV (production -> prod, preview -> dev).
APP_ENV=dev

# Absolute https origin of the backend, no trailing slash, no path.
#   Preview    -> https://api-dev.example.com
#   Production -> https://api.example.com
API_URL=https://api-dev.example.com

# true only to demo with the in-memory mock API. Never true in prod.
USE_MOCK_API=false
